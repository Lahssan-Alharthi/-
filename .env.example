# إعدادات بوابة موظفي شركة مدد للخدمات اللوجستية
# انسخ هذا الملف إلى .env واضبط القيم قبل التشغيل في بيئة الإنتاج

# الخادم
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# الأمان — إلزامي في الإنتاج، استخدم قيمة عشوائية طويلة
# مثال لتوليدها: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-before-production
JWT_EXPIRES_IN=12h

# التخزين
DB_FILE=./data/madad.db
UPLOADS_DIR=./data/uploads
MAX_UPLOAD_BYTES=8388608

# كلمة مرور الحسابات التجريبية عند تشغيل npm run seed
SEED_PASSWORD=Madad@2026
